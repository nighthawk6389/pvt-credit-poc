// ═══════════════════════ 1. IDENTITY, ACCESS & AUDIT ═══════════════════════
// Replaces free-text actor strings with real users, and makes the information
// barrier (wall-cross) an auditable event stream rather than a boolean.

model Organization {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  baseCurrency Currency @default(USD)
  createdAt    DateTime @default(now())

  memberships  OrgMembership[]
  teams        Team[]
  sponsors     Sponsor[]
  companies    Company[]
  advisors     Advisor[]
  instruments  Instrument[]
  deals        Deal[]
  funds        Fund[]
  lenders      Lender[]
  savedViews   SavedView[]
  alerts       Alert[]
  auditEvents  AuditEvent[]
  kpiSnapshots KpiSnapshot[]
  icMeetings   ICMeeting[]
  activity     ActivityEvent[]
  identifiers  InstrumentIdentifier[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  title     String?
  avatarUrl String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  memberships        OrgMembership[]
  teamMemberships    TeamMembership[]
  dealRoles          DealTeamMember[]
  uploadedDocuments  DocumentVersion[]      @relation("DocVersionAuthor")
  documentEvents     DocumentEvent[]
  grantsReceived     DocumentAccessGrant[]  @relation("GrantGrantee")
  grantsIssued       DocumentAccessGrant[]  @relation("GrantIssuer")
  tasksAssigned      Task[]                 @relation("TaskAssignee")
  tasksCreated       Task[]                 @relation("TaskCreator")
  notes              Note[]
  comments           Comment[]
  icVotes            ICVote[]
  memoVersions       MemoVersion[]
  diligenceItems     DiligenceItem[]        @relation("DiligenceAssignee")
  qaMessages         QAMessage[]
  stageTransitions   StageTransition[]
  ratingChanges      RatingHistory[]
  watchlistEvents    WatchlistEvent[]
  valuationsPrepared Valuation[]            @relation("ValuationPreparer")
  valuationsApproved Valuation[]            @relation("ValuationApprover")
  factOverrides      FundamentalFact[]      @relation("FactOverrider")
  addbacks           EbitdaAdjustment[]
  covenantWaivers    CovenantTest[]         @relation("CovenantWaiver")
  consentVotes       AmendmentConsent[]
  termSheets         TermSheet[]
  deliveriesLogged   ReportingDelivery[]
  wallCrossSubject   WallCrossEvent[]       @relation("WallCrossSubject")
  wallCrossApprover  WallCrossEvent[]       @relation("WallCrossApprover")
  alertsAssigned     Alert[]                @relation("AlertAssignee")
  savedViews         SavedView[]
  auditEvents        AuditEvent[]
  activityEvents     ActivityEvent[]
  idsVerified        InstrumentIdentifier[]
}

model OrgMembership {
  id       String       @id @default(cuid())
  orgId    String
  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId   String
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     OrgRole      @default(MEMBER)
  joinedAt DateTime     @default(now())

  @@unique([orgId, userId])
  @@index([userId])
}

model Team {
  id      String                @id @default(cuid())
  orgId   String
  org     Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name    String
  members TeamMembership[]
  grants  DocumentAccessGrant[]

  @@unique([orgId, name])
}

model TeamMembership {
  id     String @id @default(cuid())
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

/// A user's seat on a specific deal. Wall-cross state lives in WallCrossEvent;
/// this row carries the current denormalized flag for fast filtering.
model DealTeamMember {
  id            String    @id @default(cuid())
  dealId        String
  deal          Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          DealRole
  isWallCrossed Boolean   @default(false)
  addedAt       DateTime  @default(now())
  removedAt     DateTime?

  /// One open seat per person per deal: unique on (dealId, userId) WHERE
  /// removedAt IS NULL in the migration, so someone removed can be re-added.
  @@index([dealId, userId])
  @@index([userId])
  @@index([dealId, role])
}

/// Immutable compliance record of crossing/de-crossing the information barrier.
model WallCrossEvent {
  id         String   @id @default(cuid())
  dealId     String
  deal       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  subjectId  String
  subject    User     @relation("WallCrossSubject", fields: [subjectId], references: [id])
  approverId String?
  approver   User?    @relation("WallCrossApprover", fields: [approverId], references: [id])
  crossed    Boolean // true = crossed in, false = brought back over the wall
  reason     String?
  occurredAt DateTime @default(now())

  @@index([dealId, occurredAt])
  @@index([subjectId])
}

/// Append-only audit trail. Never updated or deleted.
model AuditEvent {
  id         String       @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?        @relation(fields: [actorId], references: [id])
  action     AuditAction
  entityType String
  entityId   String
  summary    String
  before     Json?
  after      Json?
  ipAddress  String?
  occurredAt DateTime     @default(now())

  @@index([orgId, occurredAt])
  @@index([entityType, entityId])
  @@index([actorId, occurredAt])
}

/// Human-readable feed powering the dashboard "Recent activity" widget.
model ActivityEvent {
  id         String       @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  dealId     String?
  deal       Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?        @relation(fields: [actorId], references: [id])
  verb       String
  target     String?
  occurredAt DateTime     @default(now())

  @@index([dealId, occurredAt])
  @@index([orgId, occurredAt])
}

// ════════════════════ 2. LINKS TO SYSTEMS OF RECORD ═══════════════════════
// The deal room is an overlay. Each thing it refers to but does not own is a
// link: a local row other tables can hold a foreign key to, carrying only the
// record's ID in its system of record. Names, descriptions, industries,
// ownership, legal-entity structure, loan terms and collateral details are
// read from the source when needed — never copied here, so they cannot drift.

/// Link to a borrower in the entity master. Its name, industry, ownership,
/// legal-entity structure and fiscal calendar are read from there.
model Company {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// The borrower's ID in the entity master.
  masterRef String
  createdAt DateTime     @default(now())

  deals            Deal[]
  financialPeriods FinancialPeriod[]
  fundamentals     FundamentalFact[]
  addbacks         EbitdaAdjustment[]
  ratings          RatingHistory[]
  watchlistEvents  WatchlistEvent[]
  identifiers      InstrumentIdentifier[]

  @@unique([orgId, masterRef])
}

/// Link to a sponsor in the entity master.
model Sponsor {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  masterRef String
  createdAt DateTime     @default(now())
  deals     Deal[]

  @@unique([orgId, masterRef])
}

/// Link to an advisor — law firm, QoE provider, consultant — in the entity master.
model Advisor {
  id        String        @id @default(cuid())
  orgId     String
  org       Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  masterRef String
  createdAt DateTime      @default(now())
  deals     DealAdvisor[]

  @@unique([orgId, masterRef])
}

/// Link to a lender in the entity master. `isSelf` marks the lender that is
/// this organisation — the one fact about it the master cannot know.
model Lender {
  id        String             @id @default(cuid())
  orgId     String
  org       Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  masterRef String
  isSelf    Boolean            @default(false)
  createdAt DateTime           @default(now())
  consents  AmendmentConsent[]

  @@unique([orgId, masterRef])
}

/// Link to a booked instrument in the security master. The instrument holds
/// the loan's terms — pricing, rate index and fixings, maturity, amortisation,
/// call protection, fees, the lender register and the cash-flow schedule — and
/// they are pulled from there. One instrument can be reached from more than
/// one deal (an add-on fungible with an existing tranche), so positions and
/// identifiers hang off the instrument rather than a deal's tranche.
model Instrument {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// The instrument's ID in the security master.
  masterRef String
  createdAt DateTime     @default(now())

  facilities  Facility[]
  positions   Position[]
  valuations  Valuation[]
  amendments  Amendment[]
  identifiers InstrumentIdentifier[]

  @@unique([orgId, masterRef])
}

/// Link to collateral in the collateral system, from the deal whose diligence
/// and monitoring cover it. What it is, what it is worth and which instruments
/// it secures are read from the collateral system.
model Collateral {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  masterRef String
  createdAt DateTime @default(now())

  @@unique([dealId, masterRef])
}

// ═══════════════════════ 3. DEAL & PIPELINE ════════════════════════════════

model Deal {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  codeName  String // project name used pre-announcement
  companyId String
  company   Company      @relation(fields: [companyId], references: [id])
  sponsorId String?
  sponsor   Sponsor?     @relation(fields: [sponsorId], references: [id])

  stage         DealStage           @default(SOURCING) // current; history in StageTransition
  status        DealStatus          @default(ACTIVE)
  channel       OriginationChannel?
  currency      Currency            @default(USD)
  targetHold    Decimal?            @db.Decimal(20, 4) // amount we intend to hold
  totalDealSize Decimal?            @db.Decimal(20, 4) // whole financing across lenders
  probability   Int?                @default(50)
  useOfProceeds String?
  thesis        String?
  targetCloseOn DateTime?           @db.Date
  closedOn      DateTime?           @db.Date
  /// Information-barrier flag: privileged deals are hidden from non-crossed users.
  isPrivileged  Boolean             @default(true)
  createdAt     DateTime            @default(now())

  team            DealTeamMember[]
  wallCrossEvents WallCrossEvent[]
  activity        ActivityEvent[]
  transitions     StageTransition[]
  milestones      Milestone[]
  advisors        DealAdvisor[]
  folders         Folder[]
  documents       Document[]
  diligenceItems  DiligenceItem[]
  qaThreads       QAThread[]
  memos           CreditMemo[]
  agendaItems     ICAgendaItem[]
  tasks           Task[]
  notes           Note[]
  comments        Comment[]
  facilities      Facility[]
  termSheets      TermSheet[]
  collateral      Collateral[]
  covenants       CovenantDefinition[]
  ebitdaDefs      EbitdaDefinition[]
  obligations     ReportingObligation[]
  amendments      Amendment[]
  alerts          Alert[]

  @@unique([orgId, codeName])
  @@index([orgId, stage])
  @@index([companyId])
  @@index([sponsorId])
}

/// Every stage change, so the dashboard can compute cycle time, conversion
/// rates and pipeline velocity. Without this, stage is an unauditable scalar.
model StageTransition {
  id          String     @id @default(cuid())
  dealId      String
  deal        Deal       @relation(fields: [dealId], references: [id], onDelete: Cascade)
  fromStage   DealStage?
  toStage     DealStage
  changedById String?
  changedBy   User?      @relation(fields: [changedById], references: [id])
  note        String?
  occurredAt  DateTime   @default(now())
  /// Days spent in fromStage — denormalized at write time for cheap analytics.
  daysInPrior Int?

  @@index([dealId, occurredAt])
  @@index([toStage, occurredAt])
}

model Milestone {
  id          String    @id @default(cuid())
  dealId      String
  deal        Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  name        String
  dueOn       DateTime? @db.Date
  completedAt DateTime?

  @@index([dealId, dueOn])
}

model DealAdvisor {
  id        String  @id @default(cuid())
  dealId    String
  deal      Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  advisorId String
  advisor   Advisor @relation(fields: [advisorId], references: [id], onDelete: Cascade)
  mandate   String?

  @@unique([dealId, advisorId])
}

// ─────────────────── Investment Committee & credit memo ───────────────────

model ICMeeting {
  id      String         @id @default(cuid())
  orgId   String
  org     Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  title   String
  heldAt  DateTime
  minutes String?
  agenda  ICAgendaItem[]

  @@index([orgId, heldAt])
}

model ICAgendaItem {
  id            String       @id @default(cuid())
  meetingId     String
  meeting       ICMeeting    @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  dealId        String
  deal          Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  /// The terms put to this committee — the version its decision applies to.
  termSheetId   String?
  termSheet     TermSheet?   @relation(fields: [termSheetId], references: [id])
  /// The memo version the committee read.
  memoVersionId String?
  memoVersion   MemoVersion? @relation(fields: [memoVersionId], references: [id])
  outcome       String?
  votes         ICVote[]

  @@unique([meetingId, dealId])
}

/// One member's vote on one agenda item. A deal that returns to committee —
/// for an add-on, an amendment or an annual review — gets a new agenda item,
/// so its earlier votes stay on the record.
model ICVote {
  id           String       @id @default(cuid())
  agendaItemId String
  agendaItem   ICAgendaItem @relation(fields: [agendaItemId], references: [id], onDelete: Cascade)
  voterId      String
  voter        User         @relation(fields: [voterId], references: [id])
  choice       ICVoteChoice
  condition    String? // for CONDITIONAL approvals
  comment      String?
  votedAt      DateTime     @default(now())

  @@unique([agendaItemId, voterId])
}

/// The memo behind one credit decision on a deal: the initial approval, an
/// add-on, an amendment or an annual review. A deal accumulates them.
model CreditMemo {
  id               String        @id @default(cuid())
  dealId           String
  deal             Deal          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  purpose          MemoPurpose   @default(INITIAL)
  status           MemoStatus    @default(DRAFT)
  recommendation   String?
  proposedRating   String?
  currentVersionId String?       @unique
  currentVersion   MemoVersion?  @relation("MemoCurrent", fields: [currentVersionId], references: [id])
  versions         MemoVersion[] @relation("MemoVersions")
  updatedAt        DateTime      @updatedAt

  @@index([dealId])
}

model MemoVersion {
  id          String         @id @default(cuid())
  memoId      String
  memo        CreditMemo     @relation("MemoVersions", fields: [memoId], references: [id], onDelete: Cascade)
  versionNo   Int
  authorId    String?
  author      User?          @relation(fields: [authorId], references: [id])
  changeNote  String?
  createdAt   DateTime       @default(now())
  sections    MemoSection[]
  currentOf   CreditMemo?    @relation("MemoCurrent")
  presentedAt ICAgendaItem[]

  @@unique([memoId, versionNo])
}

model MemoSection {
  id        String      @id @default(cuid())
  versionId String
  version   MemoVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  key       String
  title     String
  body      String
  order     Int         @default(0)

  @@unique([versionId, key])
}

// ─────────────────────── Collaboration primitives ─────────────────────────

model Task {
  id          String     @id @default(cuid())
  dealId      String
  deal        Deal       @relation(fields: [dealId], references: [id], onDelete: Cascade)
  title       String
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  assigneeId  String?
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdById String?
  createdBy   User?      @relation("TaskCreator", fields: [createdById], references: [id])
  dueOn       DateTime?  @db.Date
  completedAt DateTime?

  @@index([dealId, status])
  @@index([assigneeId, status])
}

model Note {
  id         String   @id @default(cuid())
  dealId     String
  deal       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  kind       String // MgmtCall | SiteVisit | Internal
  title      String?
  body       String
  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id])
  occurredAt DateTime @default(now())

  @@index([dealId, occurredAt])
}

model Comment {
  id         String    @id @default(cuid())
  dealId     String
  deal       Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  /// Optional anchor so a comment can hang off any record in the deal.
  entityType String?
  entityId   String?
  parentId   String?
  parent     Comment?  @relation("CommentThread", fields: [parentId], references: [id])
  replies    Comment[] @relation("CommentThread")
  authorId   String?
  author     User?     @relation(fields: [authorId], references: [id])
  body       String
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([dealId, createdAt])
  @@index([entityType, entityId])
}

// ═══════════════════════ 4. DATA ROOM & DILIGENCE ══════════════════════════

model Folder {
  id        String                @id @default(cuid())
  dealId    String
  deal      Deal                  @relation(fields: [dealId], references: [id], onDelete: Cascade)
  name      String
  parentId  String?
  parent    Folder?               @relation("FolderTree", fields: [parentId], references: [id])
  children  Folder[]              @relation("FolderTree")
  order     Int                   @default(0)
  documents Document[]
  grants    DocumentAccessGrant[]

  @@index([dealId, parentId])
}

model Document {
  id        String            @id @default(cuid())
  dealId    String
  deal      Deal              @relation(fields: [dealId], references: [id], onDelete: Cascade)
  folderId  String?
  folder    Folder?           @relation(fields: [folderId], references: [id])
  name      String
  kind      DocumentKind
  privilege DocumentPrivilege @default(DEAL_TEAM)
  isDeleted Boolean           @default(false)
  createdAt DateTime          @default(now())

  currentVersionId String?               @unique
  currentVersion   DocumentVersion?      @relation("DocCurrent", fields: [currentVersionId], references: [id])
  versions         DocumentVersion[]     @relation("DocVersions")
  grants           DocumentAccessGrant[]
  events           DocumentEvent[]
  diligenceItems   DiligenceItem[]
  deliveries       ReportingDelivery[]

  @@index([dealId, kind])
  @@index([folderId])
}

/// Real version rows — supersedes an integer `version` column, so the
/// dashboard can show "3 new versions this week" and diff history.
model DocumentVersion {
  id            String          @id @default(cuid())
  documentId    String
  document      Document        @relation("DocVersions", fields: [documentId], references: [id], onDelete: Cascade)
  versionNo     Int
  authorId      String?
  author        User?           @relation("DocVersionAuthor", fields: [authorId], references: [id])
  fileType      String
  sizeBytes     BigInt          @default(0)
  checksum      String?
  storageKey    String? // object-store pointer
  extractedText String? // OCR/parse output for search & AI grounding
  uploadedAt    DateTime        @default(now())
  currentOf     Document?       @relation("DocCurrent")
  events        DocumentEvent[]

  @@unique([documentId, versionNo])
  @@index([uploadedAt])
}

/// Explicit grant of access to a document or an entire folder, to a user or
/// a team. Absence of a grant = no access (deny by default). Exactly one of
/// documentId / folderId, and exactly one of granteeId / teamId — two CHECK
/// (num_nonnulls(...) = 1) constraints in the migration.
model DocumentAccessGrant {
  id          String    @id @default(cuid())
  documentId  String?
  document    Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  folderId    String?
  folder      Folder?   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  granteeId   String?
  grantee     User?     @relation("GrantGrantee", fields: [granteeId], references: [id], onDelete: Cascade)
  teamId      String?
  team        Team?     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  canView     Boolean   @default(true)
  canDownload Boolean   @default(false)
  issuedById  String?
  issuedBy    User?     @relation("GrantIssuer", fields: [issuedById], references: [id])
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([documentId])
  @@index([folderId])
  @@index([granteeId])
}

/// Who opened/downloaded what, when — the audit trail regulators and LPs ask for.
model DocumentEvent {
  id         String           @id @default(cuid())
  documentId String
  document   Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionId  String?
  version    DocumentVersion? @relation(fields: [versionId], references: [id])
  userId     String?
  user       User?            @relation(fields: [userId], references: [id])
  type       DocEventType
  ipAddress  String?
  occurredAt DateTime         @default(now())

  @@index([documentId, occurredAt])
  @@index([userId, occurredAt])
}

/// Due-diligence checklist item (DDQ).
model DiligenceItem {
  id         String          @id @default(cuid())
  dealId     String
  deal       Deal            @relation(fields: [dealId], references: [id], onDelete: Cascade)
  category   String
  question   String
  status     DiligenceStatus @default(OPEN)
  answer     String?
  assigneeId String?
  assignee   User?           @relation("DiligenceAssignee", fields: [assigneeId], references: [id])
  evidenceId String?
  evidence   Document?       @relation(fields: [evidenceId], references: [id])
  dueOn      DateTime?       @db.Date
  order      Int             @default(0)

  @@index([dealId, status])
  @@index([assigneeId])
}

/// Threaded Q&A with the sponsor/company during diligence.
model QAThread {
  id        String      @id @default(cuid())
  dealId    String
  deal      Deal        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  subject   String
  status    QAStatus    @default(OPEN)
  createdAt DateTime    @default(now())
  messages  QAMessage[]

  @@index([dealId, status])
}

model QAMessage {
  id         String   @id @default(cuid())
  threadId   String
  thread     QAThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id])
  /// True when posted by the counterparty rather than an internal user.
  isExternal Boolean  @default(false)
  body       String
  createdAt  DateTime @default(now())

  @@index([threadId, createdAt])
}

// ═══════════════════ 5. TRANCHES, TERM SHEETS & AMENDMENTS ═════════════════
// What the deal room owns about a financing is its decision trail: the
// tranches a deal proposes, the term-sheet versions taken to committee, and
// the amendment and consent workflow. Booked terms belong to the security
// master and are read through the Instrument link.

/// One tranche of a deal as the deal room tracks it. Before booking it is a
/// proposal, described in the deal's TermSheet; once booked it points at its
/// Instrument and its terms are read from the security master.
model Facility {
  id           String       @id @default(cuid())
  dealId       String
  deal         Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  /// Our name for the tranche within the deal: "Unitranche", "DDTL", "RCF".
  label        String
  /// Set when the tranche is booked; null while it is a proposal.
  instrumentId String?
  instrument   Instrument?  @relation(fields: [instrumentId], references: [id])
  createdAt    DateTime     @default(now())
  allocations  Allocation[]

  @@unique([dealId, label])
  @@index([instrumentId])
}

/// A version of the structure and terms proposed for a deal: the snapshot a
/// committee approves. It is a decision record, not the live terms — after
/// booking the security master is authoritative and nothing is copied back.
model TermSheet {
  id          String         @id @default(cuid())
  dealId      String
  deal        Deal           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  versionNo   Int
  /// The proposed tranches and their terms, as structured at the time.
  terms       Json
  authorId    String?
  author      User?          @relation(fields: [authorId], references: [id])
  createdAt   DateTime       @default(now())
  agendaItems ICAgendaItem[]

  @@unique([dealId, versionNo])
}

/// An amendment, waiver or consent request moving through its workflow. The
/// terms it changes are applied in the security master.
model Amendment {
  id           String             @id @default(cuid())
  dealId       String
  deal         Deal               @relation(fields: [dealId], references: [id], onDelete: Cascade)
  /// The instrument amended, when the amendment touches one.
  instrumentId String?
  instrument   Instrument?        @relation(fields: [instrumentId], references: [id])
  type         AmendmentType
  status       AmendmentStatus    @default(PROPOSED)
  title        String
  description  String?
  requestedOn  DateTime           @default(now()) @db.Date
  effectiveOn  DateTime?          @db.Date
  consents     AmendmentConsent[]

  @@index([dealId, status])
}

/// A lender's consent vote. The required threshold and each lender's share at
/// the record date come from the security master's lender register.
model AmendmentConsent {
  id          String        @id @default(cuid())
  amendmentId String
  amendment   Amendment     @relation(fields: [amendmentId], references: [id], onDelete: Cascade)
  lenderId    String?
  lender      Lender?       @relation(fields: [lenderId], references: [id])
  userId      String?
  user        User?         @relation(fields: [userId], references: [id])
  choice      ConsentChoice
  votedAt     DateTime      @default(now())

  @@unique([amendmentId, lenderId])
}

// ═══════════ 6. FINANCIALS, FUNDAMENTAL FACTS & COVENANT ENGINE ════════════

/// Data-driven field library. Makes covenant formulas reference a governed
/// vocabulary instead of hard-coded column names, and records how each field
/// aggregates across periods (the LTM / calendar-basis problem).
model FieldDefinition {
  id                String             @id @default(cuid())
  code              String             @unique // EBITDA_ADJ, TOT_DEBT, CASH...
  label             String
  unit              String // x | % | currency
  aggregation       FieldAggregation
  bloombergMnemonic String? // FA <GO> field, e.g. SALES_REV_TURN
  deriveFormula     String? // e.g. "TOT_DEBT - CASH"
  facts             FundamentalFact[]
  ebitdaBases       EbitdaDefinition[]
}

/// Metadata for a reporting period. Values live in FundamentalFact so the
/// model never needs a schema change to track a new metric.
model FinancialPeriod {
  id         String            @id @default(cuid())
  companyId  String
  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  periodEnd  DateTime          @db.Date
  periodType PeriodType
  label      String // "Q4 2025"
  currency   Currency          @default(USD)
  isActual   Boolean           @default(true) // false = projection/budget
  source     FactSource        @default(COMPLIANCE_CERT)
  facts      FundamentalFact[]

  @@unique([companyId, periodEnd, periodType, isActual])
  @@index([companyId, periodEnd])
}

model FundamentalFact {
  id             String           @id @default(cuid())
  companyId      String
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  periodId       String?
  period         FinancialPeriod? @relation(fields: [periodId], references: [id], onDelete: Cascade)
  periodEnd      DateTime         @db.Date
  periodType     PeriodType       @default(LTM)
  /// False for a budget or projection.
  isActual       Boolean          @default(true)
  fieldCode      String
  field          FieldDefinition  @relation(fields: [fieldCode], references: [code])
  value          Decimal          @db.Decimal(20, 4)
  /// Set when the field's unit is currency; null for ratios and percentages.
  currency       Currency?
  source         FactSource       @default(BLOOMBERG)
  isOverride     Boolean          @default(false)
  overriddenById String?
  overriddenBy   User?            @relation("FactOverrider", fields: [overriddenById], references: [id])
  note           String?
  recordedAt     DateTime         @default(now())

  /// One value per field, period end, period type, actual-or-projected and
  /// source lane. A quarter's EBITDA and the LTM EBITDA to the same date are
  /// different facts; overrides layer on top as their own lane.
  @@unique([companyId, periodEnd, periodType, isActual, fieldCode, source])
  @@index([companyId, periodEnd])
  @@index([fieldCode])
}

/// GAAP -> covenant-defined Adjusted EBITDA bridge. Each add-back records how
/// the agreement treats it, so the permitted amount is computed, not asserted.
model EbitdaAdjustment {
  id           String          @id @default(cuid())
  companyId    String
  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  periodEnd    DateTime        @db.Date
  label        String
  amount       Decimal         @db.Decimal(20, 4)
  currency     Currency        @default(USD)
  category     AddbackCategory
  /// CAPPED counts within the EBITDA definition's cap; UNCAPPED counts in
  /// full; EXCLUDED is recorded for the bridge but not permitted. Defaults to
  /// the conservative reading.
  capTreatment CapTreatment    @default(CAPPED)
  /// Analyst quality flag (run-rate / unrealized synergies).
  isAggressive Boolean         @default(false)
  sourceRef    String?
  createdById  String?
  createdBy    User?           @relation(fields: [createdById], references: [id])
  order        Int             @default(0)

  @@index([companyId, periodEnd])
}

/// How a deal's agreement defines covenant EBITDA: the field it starts from
/// and how far capped add-backs may take it. Shared by every covenant that
/// uses it, so the leverage and fixed-charge tests cannot disagree about what
/// EBITDA means.
model EbitdaDefinition {
  id            String               @id @default(cuid())
  dealId        String
  deal          Deal                 @relation(fields: [dealId], references: [id], onDelete: Cascade)
  name          String               @default("Consolidated EBITDA")
  /// The field the definition starts from, before add-backs.
  baseFieldCode String
  baseField     FieldDefinition      @relation(fields: [baseFieldCode], references: [code])
  /// Capped add-backs may not exceed this share of base EBITDA.
  addbackCapPct Decimal?             @db.Decimal(9, 4)
  sourceRef     String? // "Credit Agreement §1.01, 'Consolidated EBITDA'"
  covenants     CovenantDefinition[]

  @@unique([dealId, name])
}

model CovenantDefinition {
  id                 String            @id @default(cuid())
  dealId             String
  deal               Deal              @relation(fields: [dealId], references: [id], onDelete: Cascade)
  name               String
  category           CovenantCategory
  /// Human-readable expression over FieldDefinition codes.
  formula            String
  formulaAst         Json
  fieldRefs          String[]
  /// The EBITDA definition the formula uses, when it uses one.
  ebitdaDefinitionId String?
  ebitdaDefinition   EbitdaDefinition? @relation(fields: [ebitdaDefinitionId], references: [id])
  operator           CovenantOperator
  unit               String
  /// Fallback level used when no threshold step applies.
  threshold          Decimal           @db.Decimal(18, 6)
  frequency          String            @default("Quarterly")
  /// e.g. { field: "RCF_UTIL_PCT", op: ">", value: 40 } for springing tests.
  springingCondition Json?
  basketConfig       Json?
  sourceRef          String? // "Credit Agreement §7.11(a)"
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now())

  steps CovenantThresholdStep[]
  tests CovenantTest[]

  @@index([dealId, category])
}

/// Step-down / step-up schedule as rows rather than a JSON blob, so thresholds
/// are queryable and the dashboard can chart the covenant level over time.
model CovenantThresholdStep {
  id            String             @id @default(cuid())
  definitionId  String
  definition    CovenantDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  effectiveFrom DateTime           @db.Date
  value         Decimal            @db.Decimal(18, 6)

  @@unique([definitionId, effectiveFrom])
}

model CovenantTest {
  id               String             @id @default(cuid())
  definitionId     String
  definition       CovenantDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  periodEnd        DateTime           @db.Date
  testDate         DateTime           @db.Date
  /// Independently recomputed by the engine from FundamentalFacts.
  recomputedValue  Decimal?           @db.Decimal(18, 6)
  /// As stated on the borrower's compliance certificate.
  reportedValue    Decimal?           @db.Decimal(18, 6)
  reconDelta       Decimal?           @db.Decimal(18, 6)
  thresholdApplied Decimal?           @db.Decimal(18, 6)
  headroomPct      Decimal?           @db.Decimal(9, 4)
  status           CovenantStatus     @default(UPCOMING)
  /// Inputs + intermediate steps, so the math is auditable in the UI.
  formulaSnapshot  Json?
  waivedById       String?
  waivedBy         User?              @relation("CovenantWaiver", fields: [waivedById], references: [id])
  waivedAt         DateTime?
  note             String?

  @@unique([definitionId, periodEnd])
  @@index([periodEnd, status])
  @@index([status])
}

model ReportingObligation {
  id                 String              @id @default(cuid())
  dealId             String
  deal               Deal                @relation(fields: [dealId], references: [id], onDelete: Cascade)
  kind               String // Quarterly FS | Annual Audited | Compliance Cert
  dueDaysAfter       Int
  fiscalYearEndMonth Int                 @default(12)
  frequency          String              @default("Quarterly")
  deliveries         ReportingDelivery[]

  @@index([dealId])
}

model ReportingDelivery {
  id           String              @id @default(cuid())
  obligationId String
  obligation   ReportingObligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  periodEnd    DateTime            @db.Date
  dueOn        DateTime            @db.Date
  deliveredAt  DateTime?
  status       DeliveryStatus      @default(PENDING)
  documentId   String?
  document     Document?           @relation(fields: [documentId], references: [id])
  loggedById   String?
  loggedBy     User?               @relation(fields: [loggedById], references: [id])

  @@unique([obligationId, periodEnd])
  @@index([dueOn, status])
}

// ═══════════════ 7. FUNDS, POSITIONS & RETURN ECONOMICS ════════════════════

model Fund {
  id               String       @id @default(cuid())
  orgId            String
  org              Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name             String
  type             FundType     @default(MAIN_FUND)
  vintage          Int?
  currency         Currency     @default(USD)
  committedCapital Decimal?     @db.Decimal(20, 4)
  inceptionOn      DateTime?    @db.Date

  positions   Position[]
  allocations Allocation[]
  snapshots   ReturnSnapshot[]

  @@unique([orgId, name])
}

/// Target allocation of a facility across funds/SPVs, set at approval.
model Allocation {
  id           String    @id @default(cuid())
  facilityId   String
  facility     Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  fundId       String
  fund         Fund      @relation(fields: [fundId], references: [id], onDelete: Cascade)
  targetPct    Decimal?  @db.Decimal(9, 4)
  targetAmount Decimal?  @db.Decimal(20, 4)
  approvedAt   DateTime?

  @@unique([facilityId, fundId])
}

/// A fund's actual economic holding in an instrument. This — not Deal — is what
/// portfolio exposure, marks and returns roll up from.
model Position {
  id           String     @id @default(cuid())
  fundId       String
  fund         Fund       @relation(fields: [fundId], references: [id], onDelete: Cascade)
  instrumentId String
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  currency     Currency   @default(USD)
  parAmount    Decimal    @db.Decimal(20, 4)
  /// Running totals kept in step with PositionTransaction, which is the record.
  fundedAmount Decimal    @default(0) @db.Decimal(20, 4)
  costBasis    Decimal    @db.Decimal(20, 4)
  openedOn     DateTime   @db.Date
  closedOn     DateTime?  @db.Date

  transactions PositionTransaction[]
  snapshots    ReturnSnapshot[]
  identifiers  InstrumentIdentifier[]

  /// A fund holds an instrument once at a time: unique on (fundId,
  /// instrumentId) among open positions — a partial unique index WHERE
  /// closedOn IS NULL in the migration — so it can exit and re-enter.
  @@index([fundId, instrumentId])
  @@index([instrumentId])
}

/// Dated cash flows — the input to XIRR and realized/unrealized splits.
model PositionTransaction {
  id         String          @id @default(cuid())
  positionId String
  position   Position        @relation(fields: [positionId], references: [id], onDelete: Cascade)
  type       TransactionType
  tradeDate  DateTime        @db.Date
  settleDate DateTime?       @db.Date
  amount     Decimal         @db.Decimal(20, 4) // signed: outflow negative
  pricePct   Decimal?        @db.Decimal(9, 4)
  currency   Currency        @default(USD)
  note       String?

  @@index([positionId, tradeDate])
}

/// The mark for one instrument on one date, by one method. One price per
/// instrument per date, so two of our funds holding the same instrument cannot
/// carry it at different values. A position's fair value is its par times
/// the price — computed, not stored, so it cannot disagree with the mark.
model Valuation {
  id            String          @id @default(cuid())
  instrumentId  String
  instrument    Instrument      @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  asOf          DateTime        @db.Date
  method        ValuationMethod
  pricePctOfPar Decimal         @db.Decimal(9, 4)
  discountRate  Decimal?        @db.Decimal(9, 4)
  status        ValuationStatus @default(DRAFT)
  preparedById  String?
  preparedBy    User?           @relation("ValuationPreparer", fields: [preparedById], references: [id])
  approvedById  String?
  approvedBy    User?           @relation("ValuationApprover", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  note          String?

  @@unique([instrumentId, asOf, method])
  @@index([asOf, status])
}

/// Materialized IRR/MOIC so dashboard tiles don't recompute XIRR per request.
/// For exactly one of a position or a fund — CHECK (num_nonnulls(positionId,
/// fundId) = 1) in the migration.
model ReturnSnapshot {
  id          String    @id @default(cuid())
  positionId  String?
  position    Position? @relation(fields: [positionId], references: [id], onDelete: Cascade)
  fundId      String?
  fund        Fund?     @relation(fields: [fundId], references: [id], onDelete: Cascade)
  asOf        DateTime  @db.Date
  grossIrrPct Decimal?  @db.Decimal(9, 4)
  netIrrPct   Decimal?  @db.Decimal(9, 4)
  moic        Decimal?  @db.Decimal(9, 4)
  realized    Decimal?  @db.Decimal(20, 4)
  unrealized  Decimal?  @db.Decimal(20, 4)
  /// The currency realized and unrealized are stated in: the position's, or
  /// the fund's reporting currency for a fund-level snapshot.
  currency    Currency

  @@index([asOf])
  @@index([fundId, asOf])
  @@index([positionId, asOf])
}

// ═══════════════ 8. RISK HISTORY, ALERTS & DASHBOARD SUPPORT ═══════════════

/// Rating migration over time — replaces an overwritten scalar so the
/// dashboard can show upgrades/downgrades and migration matrices.
model RatingHistory {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  asOf        DateTime  @db.Date
  rating      String // internal scale, e.g. "1".."7"
  trend       RiskTrend @default(STABLE)
  rationale   String?
  changedById String?
  changedBy   User?     @relation(fields: [changedById], references: [id])

  @@unique([companyId, asOf])
  @@index([asOf])
}

model WatchlistEvent {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  asOf          DateTime @db.Date
  isOnWatchlist Boolean
  reason        String?
  changedById   String?
  changedBy     User?    @relation(fields: [changedById], references: [id])

  @@index([companyId, asOf])
}

/// Generic time-series metric store powering dashboard tiles and trend charts
/// without bespoke tables per KPI.
model KpiSnapshot {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  asOf      DateTime     @db.Date
  /// What the metric is scoped to: ORG | FUND | DEAL | POSITION | COMPANY
  scopeType String
  /// Empty for ORG scope rather than NULL, so the uniqueness rule holds:
  /// Postgres treats NULLs in a unique key as distinct.
  scopeId   String       @default("")
  metric    String // committed_capital | wtd_leverage | breach_count
  value     Decimal      @db.Decimal(24, 6)
  currency  Currency?

  @@unique([orgId, asOf, scopeType, scopeId, metric])
  @@index([metric, asOf])
}

model Alert {
  id             String        @id @default(cuid())
  orgId          String
  org            Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  dealId         String?
  deal           Deal?         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  kind           String // covenant_breach | recon_flag | late_filing
  severity       AlertSeverity @default(WARNING)
  state          AlertState    @default(OPEN)
  title          String
  body           String?
  /// Stable key so a recurring condition updates one alert instead of spamming.
  dedupeKey      String?
  assigneeId     String?
  assignee       User?         @relation("AlertAssignee", fields: [assigneeId], references: [id])
  raisedAt       DateTime      @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?

  @@unique([orgId, dedupeKey])
  @@index([orgId, state, severity])
  @@index([dealId])
}

/// Per-user saved filters/layout for a dashboard route.
model SavedView {
  id       String       @id @default(cuid())
  orgId    String
  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId   String
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  route    String // /portfolio | /covenants
  filters  Json
  isShared Boolean      @default(false)

  @@unique([userId, route, name])
}

// ═════════════════════ 9. IDENTIFIERS & CROSS-REFERENCES ═══════════════════
// The names the outside world uses for what this model links to: CUSIP, ISIN,
// LoanX and FIGI for an instrument; LEI and Bloomberg company ID for a
// borrower; the fund administrator's ID for a position. A link's masterRef is
// what reaches its system of record; these cross-references are what let
// third-party data — Bloomberg, Markit marks, agent notices — be matched to
// the right link. They are optional, plural and change over time — a tranche
// picks them up as it closes and trades, and an amend-and-extend retires one
// and issues another — so they are effective-dated rows, not columns.

/// One identifier for exactly one link, in force from validFrom until validTo:
/// CUSIP, ISIN, LoanX and FIGI on an Instrument; LEI, Bloomberg company ID and
/// CIK on a Company, as the borrower of record; the administrator's ID on a
/// Position. Retired rows are kept, so "what was this tranche called on
/// 31 March?" can be answered for marks and agent reconciliations. Enforced in
/// the migration because Prisma cannot express them: exactly one target is set
/// (CHECK num_nonnulls(...) = 1); a live value (validTo IS NULL) names one
/// thing only, and a target holds one live value per scheme and namespace
/// (partial unique indexes). Check digits are validated on write.
model InstrumentIdentifier {
  id           String       @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  companyId    String?
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  instrumentId String?
  instrument   Instrument?  @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  positionId   String?
  position     Position?    @relation(fields: [positionId], references: [id], onDelete: Cascade)
  scheme       IdScheme
  /// Normalised: upper-case, separators removed.
  value        String
  /// The issuer, for schemes unique only inside one system (agent, WSO
  /// instance). Empty rather than NULL so it takes part in the uniqueness rule.
  namespace    String       @default("")
  validFrom    DateTime     @db.Date
  /// Set when the identifier is retired; the row is kept for history.
  validTo      DateTime?    @db.Date
  source       IdSource
  verifiedById String?
  verifiedBy   User?        @relation(fields: [verifiedById], references: [id])
  verifiedAt   DateTime?
  createdAt    DateTime     @default(now())

  @@index([orgId, scheme, value])
  @@index([companyId])
  @@index([instrumentId])
  @@index([positionId])
}
