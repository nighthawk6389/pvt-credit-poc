enum DocumentKind {
  CIM
  FINANCIALS
  LEGAL
  DD_REPORT
  MODEL
  MEMO
  COMPLIANCE_CERT
  PRESENTATION
  OTHER
}

enum DocumentPrivilege {
  DEAL_TEAM
  IC
  COMPLIANCE
  ALL
}

enum DocEventType {
  VIEW
  DOWNLOAD
  PRINT
  UPLOAD
  DELETE
  SHARE
}

enum DiligenceStatus {
  OPEN
  IN_REVIEW
  CLEARED
  FLAGGED
}

enum QAStatus {
