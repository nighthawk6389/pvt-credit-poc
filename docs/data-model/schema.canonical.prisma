  IN_REVIEW
  APPROVED
  REJECTED
}

enum ICVoteChoice {
  APPROVE
  REJECT
  ABSTAIN
  CONDITIONAL
}

enum TaskStatus {
  TODO
  DOING
  DONE
  BLOCKED
}

enum Priority {
