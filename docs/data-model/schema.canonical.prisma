// ═══════════════════════════════════════════════════════════════════════════
// CANONICAL DATA MODEL — Private Credit Deal Room & Dashboard
// ═══════════════════════════════════════════════════════════════════════════
// A clean-slate, reference model for everything a deal room dashboard needs:
// identity & access, counterparties, pipeline, data room, structuring &
// syndication, covenant monitoring, fund/position economics, and the
// time-series history that dashboard analytics depend on.
//
// Target: PostgreSQL (native enums, Decimal money, partial/composite indexes).
// This is a DESIGN ARTIFACT — it is intentionally separate from the running
// app schema at prisma/schema.prisma and generates to its own client output
// so it can never clobber the live client. See README.md in this directory.
//
// Modeling rules applied throughout:
//   1. Money is Decimal(20,4) — never Float. Ratios are Decimal(18,6).
//   2. Anything a dashboard trends over time is an EVENT TABLE, not a mutable
//      scalar (stage, rating, pricing, marks, document versions).
//   3. Every actor is a User FK — no free-text name strings.
//   4. Multi-tenant: root aggregates carry orgId.
//   5. Amounts always travel with a currency; FX is a first-class table.
// ═══════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/canonical-client"
}

datasource db {
  provider = "postgresql"
  url      = env("CANONICAL_DATABASE_URL")
}

// ─────────────────────────── ENUMS ────────────────────────────────────────

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
  COMPLIANCE
  READ_ONLY
}

enum DealRole {
  DEAL_LEAD
  ANALYST
  IC_MEMBER
  COMPLIANCE
  OBSERVER
}

enum DealStage {
  SOURCING
  SCREENING
  DILIGENCE
  IC
  DOCUMENTATION
  CLOSED
  PASSED
  WITHDRAWN
}

enum DealStatus {
  ACTIVE
  ON_HOLD
  CLOSED
  PASSED
}

enum OriginationChannel {
  SPONSOR_DIRECT
  BANK_INTERMEDIATED
  ADVISOR
  INCUMBENT_LENDER
  PROPRIETARY
  CLUB
}

enum EntityRole {
  BORROWER
  CO_BORROWER
  GUARANTOR
  PLEDGOR
  HOLDCO
}

enum FacilityType {
  UNITRANCHE
  FIRST_LIEN_TL
  SECOND_LIEN
  REVOLVER
  DELAYED_DRAW
  ABL
  MEZZANINE
  HOLDCO_PIK
}

enum Seniority {
  FIRST_LIEN
  SECOND_LIEN
  UNSECURED
  SUBORDINATED
}

enum LienType {
  FIRST
  SECOND
  UNSECURED
}

enum AgentRole {
  ADMIN_AGENT
  COLLATERAL_AGENT
  LEAD_ARRANGER
  PARTICIPANT
}

enum CovenantCategory {
  MAINTENANCE
  SPRINGING
  INCURRENCE
  REPORTING
}

enum CovenantOperator {
  LTE
  GTE
}

enum CovenantStatus {
  PASS
  NEAR_BREACH
  BREACH
  RECON_FLAG
  WAIVED
  UPCOMING
  LATE
  MISSING
  NOT_APPLICABLE
}

enum PeriodType {
  QUARTER
  ANNUAL
  LTM
  YTD
  STUB
}

enum FactSource {
  BLOOMBERG
  COMPLIANCE_CERT
  OVERRIDE
  COMPUTED
  MANUAL
  AUDITED
}

enum AddbackCategory {
  SYNERGIES
  NON_RECURRING
  PRO_FORMA_MA
  STOCK_COMP
  RUN_RATE
  OTHER
}

enum FieldAggregation {
  FLOW
  STOCK
  DERIVED
