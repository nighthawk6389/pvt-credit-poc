      <xs:element name="endingBal" type="pc:Money"/>
      <xs:element name="isProjected" type="xs:boolean" default="false">
        <xs:annotation>
          <xs:documentation>Defaults to false.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- ══════ 6. FINANCIALS, FUNDAMENTAL FACTS & COVENANT ENGINE ════════════ -->

  <xs:complexType name="FieldDefinition">
    <xs:annotation>
      <xs:documentation>Data-driven field library. Makes covenant formulas reference a governed vocabulary instead of hard-coded column names, and records how each field aggregates across periods (the LTM / calendar-basis problem).</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="id" type="pc:Cuid">
        <xs:annotation>
          <xs:documentation>Primary key.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="code" type="xs:string">
        <xs:annotation>
          <xs:documentation>Note: EBITDA_ADJ, TOT_DEBT, CASH.... Unique.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="label" type="xs:string"/>
      <xs:element name="unit" type="xs:string">
        <xs:annotation>
          <xs:documentation>Note: x | % | currency.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="aggregation" type="pc:FieldAggregation"/>
      <xs:element name="bloombergMnemonic" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Note: FA &lt;GO&gt; field, e.g. SALES_REV_TURN.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="deriveFormula" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Note: e.g. &quot;TOT_DEBT - CASH&quot;.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="FinancialPeriod">
    <xs:annotation>
      <xs:documentation>Metadata for a reporting period. Values live in FundamentalFact so the model never needs a schema change to track a new metric. Unique: (companyId, periodEnd, periodType, isActual).</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="id" type="pc:Cuid">
        <xs:annotation>
          <xs:documentation>Primary key.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="companyId" type="pc:Cuid">
        <xs:annotation>
          <xs:documentation>Foreign key → Company.id.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="periodEnd" type="xs:dateTime"/>
      <xs:element name="periodType" type="pc:PeriodType"/>
      <xs:element name="label" type="xs:string">
        <xs:annotation>
          <xs:documentation>Note: &quot;Q4 2025&quot;.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="currency" type="pc:Currency" default="USD">
        <xs:annotation>
          <xs:documentation>Defaults to USD.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="isActual" type="xs:boolean" default="true">
        <xs:annotation>
          <xs:documentation>Note: false = projection/budget. Defaults to true.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="source" type="pc:FactSource" default="COMPLIANCE_CERT">
        <xs:annotation>
          <xs:documentation>Defaults to COMPLIANCE_CERT.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="FundamentalFact">
    <xs:annotation>
      <xs:documentation>Unique: (companyId, periodEnd, fieldCode, source).</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="id" type="pc:Cuid">
        <xs:annotation>
          <xs:documentation>Primary key.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="companyId" type="pc:Cuid">
        <xs:annotation>
          <xs:documentation>Foreign key → Company.id.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="periodId" type="pc:Cuid" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Foreign key → FinancialPeriod.id.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="periodEnd" type="xs:dateTime"/>
      <xs:element name="periodType" type="pc:PeriodType" default="LTM">
        <xs:annotation>
          <xs:documentation>Defaults to LTM.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="fieldCode" type="xs:string">
        <xs:annotation>
          <xs:documentation>Foreign key → FieldDefinition.code.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="value" type="pc:Money"/>
      <xs:element name="source" type="pc:FactSource" default="BLOOMBERG">
        <xs:annotation>
          <xs:documentation>Defaults to BLOOMBERG.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="isOverride" type="xs:boolean" default="false">
        <xs:annotation>
          <xs:documentation>Defaults to false.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="overriddenById" type="pc:Cuid" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Foreign key → User.id.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="note" type="xs:string" minOccurs="0"/>
      <xs:element name="recordedAt" type="xs:dateTime"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="EbitdaAdjustment">
    <xs:annotation>
      <xs:documentation>GAAP -&gt; covenant-defined Adjusted EBITDA bridge, with cap flags so the permitted amount can be computed rather than asserted.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="id" type="pc:Cuid">
        <xs:annotation>
          <xs:documentation>Primary key.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="companyId" type="pc:Cuid">
        <xs:annotation>
          <xs:documentation>Foreign key → Company.id.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="periodEnd" type="xs:dateTime"/>
      <xs:element name="label" type="xs:string"/>
      <xs:element name="amount" type="pc:Money"/>
      <xs:element name="category" type="pc:AddbackCategory"/>
      <xs:element name="isCapped" type="xs:boolean" default="false">
        <xs:annotation>
          <xs:documentation>Subject to the agreement's add-back cap (e.g. 25% of unadjusted EBITDA). Defaults to false.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="isUncapped" type="xs:boolean" default="false">
        <xs:annotation>
          <xs:documentation>Contractually uncapped — flows through in full. Defaults to false.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="isAggressive" type="xs:boolean" default="false">
        <xs:annotation>
          <xs:documentation>Analyst quality flag (run-rate / unrealized synergies). Defaults to false.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="sourceRef" type="xs:string" minOccurs="0"/>
      <xs:element name="createdById" type="pc:Cuid" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Foreign key → User.id.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="order" type="xs:int" default="0">
        <xs:annotation>
          <xs:documentation>Defaults to 0.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="CovenantDefinition">
    <xs:sequence>
      <xs:element name="id" type="pc:Cuid">
        <xs:annotation>
          <xs:documentation>Primary key.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="dealId" type="pc:Cuid">
        <xs:annotation>
          <xs:documentation>Foreign key → Deal.id.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="category" type="pc:CovenantCategory"/>
      <xs:element name="formula" type="xs:string">
        <xs:annotation>
          <xs:documentation>Human-readable expression over FieldDefinition codes.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="formulaAst" type="pc:Json"/>
      <xs:element name="fieldRefs" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="ebitdaBasis" type="xs:string" default="EBITDA_ADJ">
        <xs:annotation>
          <xs:documentation>Defaults to EBITDA_ADJ.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="operator" type="pc:CovenantOperator"/>
      <xs:element name="unit" type="xs:string"/>
      <xs:element name="threshold" type="pc:Ratio">
        <xs:annotation>
          <xs:documentation>Fallback level used when no threshold step applies.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="frequency" type="xs:string" default="Quarterly">
        <xs:annotation>
          <xs:documentation>Defaults to Quarterly.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="springingCondition" type="pc:Json" minOccurs="0">
        <xs:annotation>
          <xs:documentation>e.g. { field: &quot;RCF_UTIL_PCT&quot;, op: &quot;&gt;&quot;, value: 40 } for springing tests.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="basketConfig" type="pc:Json" minOccurs="0"/>
      <xs:element name="addbackCapPct" type="pc:Percent" minOccurs="0" default="25">
        <xs:annotation>
          <xs:documentation>Defaults to 25.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="sourceRef" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Note: &quot;Credit Agreement §7.11(a)&quot;.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="isActive" type="xs:boolean" default="true">
        <xs:annotation>
          <xs:documentation>Defaults to true.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="createdAt" type="xs:dateTime"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="CovenantThresholdStep">
    <xs:annotation>
      <xs:documentation>Step-down / step-up schedule as rows rather than a JSON blob, so thresholds are queryable and the dashboard can chart the covenant level over time. Unique: (definitionId, effectiveFrom).</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="id" type="pc:Cuid">
        <xs:annotation>
          <xs:documentation>Primary key.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="definitionId" type="pc:Cuid">
        <xs:annotation>
          <xs:documentation>Foreign key → CovenantDefinition.id.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="effectiveFrom" type="xs:dateTime"/>
      <xs:element name="value" type="pc:Ratio"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="CovenantTest">
    <xs:annotation>
      <xs:documentation>Unique: (definitionId, periodEnd).</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="id" type="pc:Cuid">
        <xs:annotation>
          <xs:documentation>Primary key.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="definitionId" type="pc:Cuid">
        <xs:annotation>
          <xs:documentation>Foreign key → CovenantDefinition.id.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="periodEnd" type="xs:dateTime"/>
      <xs:element name="testDate" type="xs:dateTime"/>
      <xs:element name="recomputedValue" type="pc:Ratio" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Independently recomputed by the engine from FundamentalFacts.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="reportedValue" type="pc:Ratio" minOccurs="0">
        <xs:annotation>
          <xs:documentation>As stated on the borrower's compliance certificate.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="reconDelta" type="pc:Ratio" minOccurs="0"/>
      <xs:element name="thresholdApplied" type="pc:Ratio" minOccurs="0"/>
      <xs:element name="headroomPct" type="pc:Percent" minOccurs="0"/>
      <xs:element name="status" type="pc:CovenantStatus" default="UPCOMING">
        <xs:annotation>
          <xs:documentation>Defaults to UPCOMING.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="formulaSnapshot" type="pc:Json" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Inputs + intermediate steps, so the math is auditable in the UI.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="waivedById" type="pc:Cuid" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Foreign key → User.id.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="waivedAt" type="xs:dateTime" minOccurs="0"/>
      <xs:element name="note" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ReportingObligation">
    <xs:sequence>
      <xs:element name="id" type="pc:Cuid">
        <xs:annotation>
          <xs:documentation>Primary key.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="dealId" type="pc:Cuid">
        <xs:annotation>
          <xs:documentation>Foreign key → Deal.id.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="kind" type="xs:string">
        <xs:annotation>
          <xs:documentation>Note: Quarterly FS | Annual Audited | Compliance Cert.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="dueDaysAfter" type="xs:int"/>
      <xs:element name="fiscalYearEndMonth" type="xs:int" default="12">
        <xs:annotation>
          <xs:documentation>Defaults to 12.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="frequency" type="xs:string" default="Quarterly">
        <xs:annotation>
          <xs:documentation>Defaults to Quarterly.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ReportingDelivery">
    <xs:annotation>
      <xs:documentation>Unique: (obligationId, periodEnd).</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="id" type="pc:Cuid">
        <xs:annotation>
          <xs:documentation>Primary key.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="obligationId" type="pc:Cuid">
        <xs:annotation>
          <xs:documentation>Foreign key → ReportingObligation.id.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="periodEnd" type="xs:dateTime"/>
      <xs:element name="dueOn" type="xs:dateTime"/>
      <xs:element name="deliveredAt" type="xs:dateTime" minOccurs="0"/>
      <xs:element name="status" type="pc:DeliveryStatus" default="PENDING">
        <xs:annotation>
          <xs:documentation>Defaults to PENDING.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="documentId" type="xs:string" minOccurs="0"/>
      <xs:element name="loggedById" type="pc:Cuid" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Foreign key → User.id.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- ══════ 7. FUNDS, POSITIONS & RETURN ECONOMICS ════════════════════════ -->

  <xs:complexType name="Fund">
    <xs:annotation>
      <xs:documentation>Unique: (orgId, name).</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="id" type="pc:Cuid">
        <xs:annotation>
          <xs:documentation>Primary key.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="orgId" type="pc:Cuid">
        <xs:annotation>
          <xs:documentation>Foreign key → Organization.id.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="type" type="pc:FundType" default="MAIN_FUND">
        <xs:annotation>
          <xs:documentation>Defaults to MAIN_FUND.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="vintage" type="xs:int" minOccurs="0"/>
      <xs:element name="currency" type="pc:Currency" default="USD">
        <xs:annotation>
          <xs:documentation>Defaults to USD.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="committedCapital" type="pc:Money" minOccurs="0"/>
      <xs:element name="inceptionOn" type="xs:dateTime" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Allocation">
    <xs:annotation>
      <xs:documentation>Target allocation of a facility across funds/SPVs, set at approval. Unique: (facilityId, fundId).</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="id" type="pc:Cuid">
        <xs:annotation>
          <xs:documentation>Primary key.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="facilityId" type="pc:Cuid">
        <xs:annotation>
          <xs:documentation>Foreign key → Facility.id.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="fundId" type="pc:Cuid">
        <xs:annotation>
          <xs:documentation>Foreign key → Fund.id.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="targetPct" type="pc:Percent" minOccurs="0"/>
      <xs:element name="targetAmount" type="pc:Money" minOccurs="0"/>
      <xs:element name="approvedAt" type="xs:dateTime" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Position">
    <xs:annotation>
      <xs:documentation>A fund's actual economic holding in a facility. This — not Deal — is what portfolio exposure, marks and returns roll up from. Unique: (fundId, facilityId).</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="id" type="pc:Cuid">
        <xs:annotation>
          <xs:documentation>Primary key.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="fundId" type="pc:Cuid">
        <xs:annotation>
          <xs:documentation>Foreign key → Fund.id.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="facilityId" type="pc:Cuid">
        <xs:annotation>
          <xs:documentation>Foreign key → Facility.id.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="currency" type="pc:Currency" default="USD">
        <xs:annotation>
          <xs:documentation>Defaults to USD.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="parAmount" type="pc:Money"/>
      <xs:element name="fundedAmount" type="pc:Money" default="0">
        <xs:annotation>
          <xs:documentation>Defaults to 0.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="costBasis" type="pc:Money"/>
      <xs:element name="openedOn" type="xs:dateTime"/>
      <xs:element name="closedOn" type="xs:dateTime" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="PositionTransaction">
    <xs:annotation>
      <xs:documentation>Dated cash flows — the input to XIRR and realized/unrealized splits.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="id" type="pc:Cuid">
        <xs:annotation>
          <xs:documentation>Primary key.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="positionId" type="pc:Cuid">
        <xs:annotation>
          <xs:documentation>Foreign key → Position.id.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="type" type="pc:TransactionType"/>
      <xs:element name="tradeDate" type="xs:dateTime"/>
      <xs:element name="settleDate" type="xs:dateTime" minOccurs="0"/>
      <xs:element name="amount" type="pc:Money">
        <xs:annotation>
          <xs:documentation>Note: signed: outflow negative.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="pricePct" type="pc:Percent" minOccurs="0"/>
      <xs:element name="currency" type="pc:Currency" default="USD">
        <xs:annotation>
          <xs:documentation>Defaults to USD.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="note" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Valuation">
    <xs:annotation>
      <xs:documentation>Unique: (positionId, asOf, method).</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="id" type="pc:Cuid">
        <xs:annotation>
          <xs:documentation>Primary key.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="positionId" type="pc:Cuid">
        <xs:annotation>
          <xs:documentation>Foreign key → Position.id.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="asOf" type="xs:dateTime"/>
      <xs:element name="method" type="pc:ValuationMethod"/>
      <xs:element name="pricePctOfPar" type="pc:Percent"/>
      <xs:element name="fairValue" type="pc:Money"/>
      <xs:element name="discountRate" type="pc:Percent" minOccurs="0"/>
      <xs:element name="status" type="pc:ValuationStatus" default="DRAFT">
        <xs:annotation>
          <xs:documentation>Defaults to DRAFT.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="preparedById" type="pc:Cuid" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Foreign key → User.id.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="approvedById" type="pc:Cuid" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Foreign key → User.id.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="approvedAt" type="xs:dateTime" minOccurs="0"/>
      <xs:element name="note" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ReturnSnapshot">
    <xs:annotation>
      <xs:documentation>Materialized IRR/MOIC so dashboard tiles don't recompute XIRR per request.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="id" type="pc:Cuid">
        <xs:annotation>
          <xs:documentation>Primary key.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="positionId" type="pc:Cuid" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Foreign key → Position.id.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="fundId" type="pc:Cuid" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Foreign key → Fund.id.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="asOf" type="xs:dateTime"/>
      <xs:element name="grossIrrPct" type="pc:Percent" minOccurs="0"/>
      <xs:element name="netIrrPct" type="pc:Percent" minOccurs="0"/>
      <xs:element name="moic" type="pc:Percent" minOccurs="0"/>
      <xs:element name="realized" type="pc:Money" minOccurs="0"/>
      <xs:element name="unrealized" type="pc:Money" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ══════ 8. RISK HISTORY, ALERTS & DASHBOARD SUPPORT ═══════════════════ -->

  <xs:complexType name="RatingHistory">
    <xs:annotation>
      <xs:documentation>Rating migration over time — replaces an overwritten scalar so the dashboard can show upgrades/downgrades and migration matrices. Unique: (companyId, asOf).</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="id" type="pc:Cuid">
        <xs:annotation>
          <xs:documentation>Primary key.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="companyId" type="pc:Cuid">
        <xs:annotation>
          <xs:documentation>Foreign key → Company.id.</xs:documentation>
