    </FieldDefinition>
    <FieldDefinition>
      <id>fld_ebitda_adj</id><code>EBITDA_ADJ</code>
      <label>Covenant Adjusted EBITDA</label><unit>currency</unit>
      <aggregation>FLOW</aggregation>
      <deriveFormula>EBITDA + PERMITTED_ADDBACKS</deriveFormula>
    </FieldDefinition>
    <FieldDefinition>
      <id>fld_tot_debt</id><code>TOT_DEBT</code>
      <label>Total Debt</label><unit>currency</unit>
