    <CovenantThresholdStep>
      <id>stp_2</id><definitionId>cov_arcline_lev</definitionId>
      <effectiveFrom>2027-01-01</effectiveFrom><value>5.000000</value>
    </CovenantThresholdStep>
    <CovenantThresholdStep>
      <id>stp_3</id><definitionId>cov_arcline_lev</definitionId>
      <effectiveFrom>2028-01-01</effectiveFrom><value>4.500000</value>
    </CovenantThresholdStep>
  </CovenantThresholdSteps>

  <!-- Recomputed 4.755x on the override basis vs 4.485x as certified: a
       0.27x gap, so the test lands on RECON_FLAG rather than a silent PASS. -->
  <CovenantTests>
    <CovenantTest>
      <id>tst_q2_2026</id>
      <definitionId>cov_arcline_lev</definitionId>
      <periodEnd>2026-06-30</periodEnd>
      <testDate>2026-08-14</testDate>
      <recomputedValue>4.755011</recomputedValue>
      <reportedValue>4.485294</reportedValue>
      <reconDelta>0.269717</reconDelta>
      <thresholdApplied>5.500000</thresholdApplied>
      <headroomPct>13.5453</headroomPct>
      <status>RECON_FLAG</status>
      <formulaSnapshot>{"TOT_DEBT":232000000,"CASH":18500000,"EBITDA_ADJ":44900000,"basis":"OVERRIDE"}</formulaSnapshot>
      <note>Delta is the capped add-back haircut; certificate used the sponsor's uncapped figure.</note>
    </CovenantTest>
  </CovenantTests>

