  <!-- ── Covenant: definition, step-down schedule, one test ────────────── -->
  <!-- The agreement defines covenant EBITDA once; every covenant that uses it
       points here, so the cap cannot differ between leverage and coverage. -->
  <EbitdaDefinitions>
    <EbitdaDefinition>
      <id>ebd_lantern</id><dealId>deal_arcline</dealId>
      <name>Consolidated EBITDA</name>
      <baseFieldCode>EBITDA</baseFieldCode>
      <addbackCapPct>25.0000</addbackCapPct>
      <sourceRef>Credit Agreement §1.01, "Consolidated EBITDA"</sourceRef>
    </EbitdaDefinition>
  </EbitdaDefinitions>

  <CovenantDefinitions>
    <CovenantDefinition>
      <id>cov_arcline_lev</id>
      <dealId>deal_arcline</dealId>
      <name>Total Net Leverage</name>
      <category>MAINTENANCE</category>
      <formula>(TOT_DEBT - CASH) / EBITDA_ADJ</formula>
      <formulaAst>{"op":"/","left":{"op":"-","left":"TOT_DEBT","right":"CASH"},"right":"EBITDA_ADJ"}</formulaAst>
      <fieldRefs>TOT_DEBT</fieldRefs>
      <fieldRefs>CASH</fieldRefs>
      <fieldRefs>EBITDA_ADJ</fieldRefs>
      <ebitdaDefinitionId>ebd_lantern</ebitdaDefinitionId>
      <operator>LTE</operator>
      <unit>x</unit>
      <threshold>5.500000</threshold>
      <frequency>Quarterly</frequency>
      <sourceRef>Credit Agreement §7.11(a)</sourceRef>
      <isActive>true</isActive>
      <createdAt>2026-01-28T00:00:00Z</createdAt>
    </CovenantDefinition>
  </CovenantDefinitions>

  <CovenantThresholdSteps>
